{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": [
      "ES2022"
    ],
    "paths": {
      "@data/*": [
        "../../app/src/data/*"
      ],
      "@scripts/*": [
        "../../app/scripts/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}