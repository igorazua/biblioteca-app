{
  "name": "biblioteca-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env.local scripts/build-seed.mjs --fast && node --env-file-if-exists=.env.local scripts/engine/additions.mjs && node scripts/engine/build.mjs && node scripts/localize-titles.mjs && node scripts/dedupe-twins.mjs",
    "icons": "node scripts/make-icons.mjs",
    "engine:sources": "node --env-file-if-exists=.env.local scripts/engine/sources.mjs",
    "engine:build": "node scripts/engine/build.mjs",
    "engine:graph": "node scripts/engine/graph-import.mjs",
    "engine:context": "node scripts/engine/context.mjs",
    "engine:vectors": "node scripts/engine/vectors.mjs",
    "engine:neighbors": "node scripts/engine/neighbors-llm.mjs",
    "engine:merge": "node scripts/engine/merge.mjs",
    "engine:coverage": "node scripts/engine/coverage.mjs",
    "engine:all": "npm run engine:sources && npm run engine:build && npm run engine:graph && npm run engine:context && npm run engine:vectors && npm run engine:neighbors && npm run engine:merge && npm run engine:coverage",
    "engine": "npm run engine:sources && npm run engine:build && npm run engine:coverage",
    "catalog:upload": "node --env-file-if-exists=.env.local scripts/catalog-upload.mjs",
    "build-preview": "npm run build && vite preview --port 4173 --host"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.2.0",
    "idb-keyval": "^6.3.0",
    "lz-string": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xenova/transformers": "^2.17.2",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
